# Copy this file to a new file called  .env  (same folder) and fill it in. Never share or upload the real .env.

# ---- Where the data is stored: your Supabase database ----
# Supabase dashboard > Connect > "Transaction pooler" > copy the URI, then put your database password in place of [YOUR-PASSWORD].
# If the password has symbols such as @ # / : % ?, write them as %40 %23 %2F %3A %25 %3F (or reset it to letters and numbers).
DATABASE_URL=postgresql://postgres.YOURPROJECTREF:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# ---- Always needed ----
ADMIN_USER=admin
ADMIN_PASSWORD=admin
TZ_NAME=Asia/Kolkata
GRACE_MINUTES=20

# ---- Testing on your laptop (remove these lines for the real launch) ----
DEV_LOGIN=1
# FAKE_NOW=2026-10-31T10:00     # pretend it is 10 AM so you can book at night

# ---- Real launch only ----
# APP_ENV=production
# SECRET_KEY=change-me-to-a-long-random-string        # signs login tokens
# QR_SECRET=change-me-to-another-long-random-string   # signs the QR codes
# ALLOWED_ORIGINS=https://your-library-site.example.edu
# CRON_KEY=another-random-text                         # lets a free scheduler call /api/internal/release
