# Put this in front of several API servers (copy into /etc/nginx/conf.d/libseat.conf)
limit_req_zone $binary_remote_addr zone=perip:20m rate=20r/s;
upstream libseat_api { least_conn; server 10.0.0.11:8000; server 10.0.0.12:8000; server 10.0.0.13:8000; keepalive 64; }
server {
  listen 443 ssl http2;
  server_name seats.example.edu;
  # ssl_certificate / ssl_certificate_key ...
  location /api/ { limit_req zone=perip burst=60 nodelay; proxy_pass http://libseat_api; proxy_http_version 1.1; proxy_set_header Connection ""; proxy_set_header Host $host; proxy_set_header X-Real-IP $remote_addr; }
  location / { root /var/www/libseat; try_files $uri /index.html; add_header Cache-Control "public, max-age=300"; }  # the front-end files
}
